rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if request is authenticated with a valid UID
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Check if user profile document exists in Firestore
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Get trusted user record from Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if user is explicitly deactivated in their Firestore profile
    function isDeactivated() {
      return userExists() && getUserData().active == false;
    }

    // Check if user is active and authorized
    function isActive() {
      return isAuthenticated() && !isDeactivated() && (
        (userExists() && getUserData().active == true) ||
        request.auth.token.admin == true ||
        request.auth.token.role in ['admin', 'staff', 'photographer'] ||
        request.auth.uid == '99NIadNmrqVKWyWMngiMoAmYfOf1'
      );
    }

    // Check if user has admin role (via token claims, root admin UID, or Firestore profile)
    function isAdmin() {
      return isAuthenticated() && !isDeactivated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.uid == '99NIadNmrqVKWyWMngiMoAmYfOf1' ||
        (userExists() && getUserData().role == 'admin')
      );
    }

    // Check if user has staff or admin role
    function isStaffOrAdmin() {
      return isAuthenticated() && !isDeactivated() && (
        isAdmin() ||
        request.auth.token.role == 'staff' ||
        (userExists() && (getUserData().role == 'staff' || getUserData().role == 'admin'))
      );
    }

    // Check if user has any authorized studio role (admin, staff, photographer)
    function isStudioMember() {
      return isAuthenticated() && !isDeactivated() && (
        isStaffOrAdmin() ||
        request.auth.token.role == 'photographer' ||
        (userExists() && (
          getUserData().role == 'photographer' ||
          getUserData().role == 'staff' ||
          getUserData().role == 'admin'
        ))
      );
    }

    // Studio team members collection
    match /users/{userId} {
      // Authenticated users can read team profiles
      allow read: if isAuthenticated();
      
      // Admins can provision new staff accounts, or root admin can auto-heal own profile
      allow create: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId && 
        (request.auth.token.admin == true || request.auth.token.role == 'admin' || request.auth.uid == '99NIadNmrqVKWyWMngiMoAmYfOf1')
      );
      
      // Admins can update any user; users can update their own profile details
      // Staff CANNOT change their own role or active status
      allow update: if isAdmin() || (
        isActive() && 
        request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active'])
      );
      
      // Admins cannot delete their own account to prevent lockout
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // Clients collection
    match /clients/{clientId} {
      allow read: if isStudioMember();
      allow create, update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    // Photography packages collection
    match /packages/{packageId} {
      allow read: if isStudioMember();
      allow create: if isStaffOrAdmin();
      allow update: if isStaffOrAdmin() && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isDeleted', 'deletedAt', 'deletedByUid', 'deletedByName']) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if isStudioMember();
      allow create, update: if isStaffOrAdmin();
      allow delete: if isAdmin();
    }

    // Payments collection - strictly protected financial records
    match /payments/{paymentId} {
      allow read: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin() && 
        request.resource.data.amount > 0 &&
        request.resource.data.recordedByUid == request.auth.uid &&
        request.resource.data.receiptNumber.matches('^REC-[0-9]{4}-[0-9]{4,}$');
      
      // Updates strictly restricted to audited reversals
      allow update: if isStaffOrAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isReversed', 'reversalReason', 'reversedAt', 'reversedByUid', 'reversedByName', 'updatedAt']) &&
        request.resource.data.isReversed == true &&
        request.resource.data.reversalReason is string &&
        request.resource.data.reversalReason.size() > 0 &&
        resource.data.isReversed != true;

      allow delete: if false; // Strict: Never silently delete financial records!
    }

    // Studio expenses collection
    match /expenses/{expenseId} {
      allow read: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin() &&
        request.resource.data.amount > 0 &&
        request.resource.data.recordedByUid == request.auth.uid;

      // Updates can modify details or reversal, but cannot tamper with creation attribution or original id
      allow update: if isStaffOrAdmin() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'createdAt', 'recordedByUid']);

      allow delete: if false; // Strict: Never silently delete financial records!
    }

    // Concurrency sequence counters (e.g. receipts REC-YYYY-XXXX)
    match /counters/{counterId} {
      allow read: if isStaffOrAdmin();
      // On create, initial sequence must start at 1
      allow create: if isStaffOrAdmin() && request.resource.data.lastSeq == 1;
      // On update, sequence must strictly be an atomic increment of exactly 1
      allow update: if isStaffOrAdmin() && (
        !('lastSeq' in resource.data) ||
        request.resource.data.lastSeq == resource.data.lastSeq + 1
      );
      allow delete: if false; // Strict: Never delete sequence counters
    }

    // Activity audit logs - append-only trail
    match /activity_logs/{logId} {
      allow read: if isStudioMember();
      allow create: if isStudioMember();
      allow update, delete: if false; // Strict: Append-only audit trail
    }
  }
}
